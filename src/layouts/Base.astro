---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  cover?: string;
}

const { title, description = '豆芽的技术博客：前端、AI、游戏、硬件、篮球与技术圈观察', cover } = Astro.props;
const site = 'https://zhaojiale001016.github.io';
const canonical = site + Astro.url.pathname;
const ogImage = cover ? site + cover : undefined;
const path = Astro.url.pathname;
// 全站文章 id 列表（随机漫游用）
import { getCollection } from 'astro:content';
const postIds = (await getCollection('blog')).map((p) => p.id);
// 构建信息：git 短哈希 + 构建时间
import { execSync } from 'node:child_process';
let commit = 'dev';
try {
  commit = execSync('git rev-parse --short HEAD').toString().trim();
} catch {}
const buildTime = new Date().toISOString().slice(0, 16).replace('T', ' ');
const nav = [
  { href: '/', label: '首页' },
  { href: '/archives', label: '归档' },
  { href: '/tags', label: '标签' },
  { href: '/stats', label: '统计' },
  { href: '/subscribe', label: '订阅' },
  { href: '/search', label: '搜索' },
  { href: '/about', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="180x180" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="豆芽的技术博客" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 豆芽的技术博客`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · 豆芽的技术博客</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="path glitch">豆芽@blog:~$</span> whoami<span class="cursor"></span>
        </a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'active' : ''}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="copy">© {new Date().getFullYear()} 豆芽 · exit code 0
          <span id="busuanzi_container_site_pv" style="display:none"> · pv <span id="busuanzi_value_site_pv"></span></span>
          <span id="busuanzi_container_site_uv" style="display:none"> · uv <span id="busuanzi_value_site_uv"></span></span>
        </div>
        <div class="links">
          <a href="https://github.com/zhaojiale001016" target="_blank" rel="noopener">github</a>
          <span class="dot">·</span>
          <a href="#" id="random-post">随机</a>
          <span class="dot">·</span>
          <a href="/rss.xml">rss</a>
          <span class="dot">·</span>
          <a href="/uses">工具</a>
          <span class="dot">·</span>
          <a href="/friends">友链</a>
          <span class="dot">·</span>
          <a href="/graph">图谱</a>
          <span class="dot">·</span>
          <a href="/now">now</a>
          <span class="dot">·</span>
          <a href="/guestbook">留言板</a>

        </div>
      </div>
    </footer>
    <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <script is:inline define:vars={{ postIds }}>
      window.__POSTS = postIds;
      // 键盘快捷键
      let gPending = false, _escLast = 0;
      const toast = (msg) => {
        let t = document.getElementById('kbd-toast');
        if (!t) {
          t = document.createElement('div');
          t.id = 'kbd-toast';
          t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#242b27;color:#f2efe7;padding:10px 18px;border-radius:8px;font-size:12px;z-index:200;font-family:inherit;white-space:pre;line-height:1.7';
          document.body.appendChild(t);
        }
        t.textContent = msg;
        t.style.display = 'block';
        clearTimeout(t._h);
        t._h = setTimeout(() => (t.style.display = 'none'), 2600);
      };
      const randomPost = () => {
        if (!postIds.length) return;
        const id = postIds[Math.floor(Math.random() * postIds.length)];
        location.href = '/posts/' + id;
      };
      document.getElementById('random-post')?.addEventListener('click', (e) => { e.preventDefault(); randomPost(); });
      document.addEventListener('keydown', (e) => {
        const tag = document.activeElement?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.metaKey || e.ctrlKey || e.altKey) return;
        if (gPending) {
          gPending = false;
          const map = { h: '/', a: '/archives', t: '/tags', s: '/stats' };
          if (map[e.key]) location.href = map[e.key];
          return;
        }
        switch (e.key) {
          case 'g': gPending = true; setTimeout(() => (gPending = false), 800); break;
          case '/': e.preventDefault(); location.href = '/search'; break;
          case 'r': randomPost(); break;
          case 'ArrowLeft': {
            const el = document.querySelector('.post-nav .pn:not(.right)');
            if (el?.href) location.href = el.href;
            break;
          }
          case 'ArrowRight': {
            const el = document.querySelector('.post-nav .pn.right');
            if (el?.href) location.href = el.href;
            break;
          }
          case 'Escape': {
            const now = Date.now();
            if (now - _escLast < 500) {
              toast('快捷键\n  /        搜索\n  r        随机看一篇\n  ← / →    上一篇 / 下一篇（文章页）\n  g h      首页\n  g a      归档\n  g t      标签\n  g s      统计');
              _escLast = 0;
            } else {
              _escLast = now;
            }
            break;
          }
        }
      });
      // 双击页脚 exit code 彩蛋
      document.querySelector('.copy')?.addEventListener('dblclick', () => {
        toast('✨ 你发现了豆芽的秘密通道');
      });
    </script>
    <!-- 博客宠物 -->
    <div class="sprout-pet" id="sprout-pet" title="豆芽小精灵">
      <div class="pet-bubble">你好呀～我是小豆芽</div>
      <svg viewBox="0 0 48 48" fill="none">
        <g class="pet-body">
          <ellipse cx="24" cy="38" rx="10" ry="8" fill="#43a047" opacity=".9"/>
          <path d="M24 30 Q22 22 18 16 Q16 12 14 14 Q12 16 16 20 Q20 24 24 30" fill="#66bb6a"/>
          <path d="M24 30 Q26 22 30 16 Q32 12 34 14 Q36 16 32 20 Q28 24 24 30" fill="#66bb6a"/>
          <g class="pet-eyes">
            <circle cx="20" cy="36" r="1.5" fill="#fff"/>
            <circle cx="28" cy="36" r="1.5" fill="#fff"/>
          </g>
          <path d="M21 40 Q24 42 27 40" stroke="#fff" stroke-width="1" fill="none" stroke-linecap="round"/>
        </g>
      </svg>
    </div>

    <!-- Matrix 代码雨 -->
    <canvas class="matrix-rain" id="matrix-rain"></canvas>
    <button class="matrix-toggle" id="matrix-toggle" title="代码雨开关">▓ rain</button>

    <script is:inline>
      // 不蒜子加载完成后显示统计数字
      const t = setInterval(() => {
        if (document.getElementById('busuanzi_value_site_pv')?.innerText) {
          document.getElementById('busuanzi_container_site_pv')?.style.removeProperty('display');
          document.getElementById('busuanzi_container_site_uv')?.style.removeProperty('display');
          clearInterval(t);
        }
      }, 500);
      setTimeout(() => clearInterval(t), 8000);

      // 博客宠物点击互动
      const pet = document.getElementById('sprout-pet');
      const messages = ['你好呀～我是小豆芽', '今天也要加油哦', '点我干嘛，写文章去', '咕…', '博客又更新了？'];
      let msgIdx = 0;
      pet?.addEventListener('click', () => {
        msgIdx = (msgIdx + 1) % messages.length;
        const bubble = pet.querySelector('.pet-bubble');
        if (bubble) bubble.textContent = messages[msgIdx];
      });

      // Matrix 代码雨
      const canvas = document.getElementById('matrix-rain');
      const toggle = document.getElementById('matrix-toggle');
      let rainActive = false, rainRAF = null;
      function startRain() {
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const chars = 'アイウエオカキクケコサシスセソ0123456789ABCDEF';
        const fontSize = 14;
        const cols = Math.floor(canvas.width / fontSize);
        const drops = Array(cols).fill(1);
        function draw() {
          ctx.fillStyle = 'rgba(242,239,231,.1)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#43a047';
          ctx.font = fontSize + 'px monospace';
          for (let i = 0; i < drops.length; i++) {
            ctx.fillText(chars[Math.floor(Math.random() * chars.length)], i * fontSize, drops[i] * fontSize);
            if (drops[i] * fontSize > canvas.height && Math.random() > .975) drops[i] = 0;
            drops[i]++;
          }
          rainRAF = requestAnimationFrame(draw);
        }
        draw();
      }
      function stopRain() {
        if (rainRAF) cancelAnimationFrame(rainRAF);
        rainRAF = null;
      }
      toggle?.addEventListener('click', () => {
        rainActive = !rainActive;
        canvas.classList.toggle('active', rainActive);
        toggle.textContent = rainActive ? '▓ stop' : '▓ rain';
        if (rainActive) startRain(); else stopRain();
      });
      window.addEventListener('resize', () => { if (rainActive) { stopRain(); startRain(); } });
    </script>
  </body>
</html>
