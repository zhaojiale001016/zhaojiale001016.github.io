---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  cover?: string;
}

const { title, description = '豆芽的技术博客：前端、AI、游戏、硬件与技术圈观察', cover } = Astro.props;
const site = 'https://zhaojiale001016.github.io';
const canonical = site + Astro.url.pathname;
const ogImage = cover ? site + cover : undefined;
const path = Astro.url.pathname;
// 构建信息：git 短哈希 + 构建时间
import { execSync } from 'node:child_process';
let commit = 'dev';
try {
  commit = execSync('git rev-parse --short HEAD').toString().trim();
} catch {}
const buildTime = new Date().toISOString().slice(0, 16).replace('T', ' ');
const nav = [
  { href: '/', label: 'home' },
  { href: '/archives', label: 'archives' },
  { href: '/tags', label: 'tags' },
  { href: '/search', label: 'search' },
  { href: '/about', label: 'about' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="180x180" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="豆芽的技术博客" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 豆芽的技术博客`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · 豆芽的技术博客</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="path">douya@blog:~$</span> whoami<span class="cursor"></span>
        </a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'active' : ''}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="copy">© {new Date().getFullYear()} douya · built with Astro · <a class="commit" href={`https://github.com/zhaojiale001016/zhaojiale001016.github.io/commit/${commit}`} target="_blank" rel="noopener">{commit}</a> · {buildTime} · exit code 0
          <span id="busuanzi_container_site_pv" style="display:none"> · pv <span id="busuanzi_value_site_pv"></span></span>
          <span id="busuanzi_container_site_uv" style="display:none"> · uv <span id="busuanzi_value_site_uv"></span></span>
        </div>
        <div class="links">
          <a href="https://github.com/zhaojiale001016" target="_blank" rel="noopener">github</a>
          <a href="/rss.xml">rss</a>
          <a href="/sitemap-index.xml">sitemap</a>
        </div>
      </div>
    </footer>
    <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <script is:inline>
      // 不蒜子加载完成后显示统计数字
      const t = setInterval(() => {
        if (document.getElementById('busuanzi_value_site_pv')?.innerText) {
          document.getElementById('busuanzi_container_site_pv')?.style.removeProperty('display');
          document.getElementById('busuanzi_container_site_uv')?.style.removeProperty('display');
          clearInterval(t);
        }
      }, 500);
      setTimeout(() => clearInterval(t), 8000);
    </script>
  </body>
</html>
