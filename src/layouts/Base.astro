---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  cover?: string;
}

const { title, description = '豆芽的技术博客：前端、AI、游戏、硬件、篮球与技术圈观察', cover } = Astro.props;
const site = 'https://zhaojiale001016.github.io';
const canonical = site + Astro.url.pathname;
const ogImage = cover ? site + cover : undefined;
const path = Astro.url.pathname;
// 全站文章 id 列表（随机漫游用）
import { getCollection } from 'astro:content';
const postIds = (await getCollection('blog')).map((p) => p.id);
// 构建信息：git 短哈希 + 构建时间
import { execSync } from 'node:child_process';
let commit = 'dev';
try {
  commit = execSync('git rev-parse --short HEAD').toString().trim();
} catch {}
const buildTime = new Date().toISOString().slice(0, 16).replace('T', ' ');
const nav = [
  { href: '/', label: '首页' },
  { href: '/archives', label: '归档' },
  { href: '/tags', label: '标签' },
  { href: '/stats', label: '统计' },
  { href: '/subscribe', label: '订阅' },
  { href: '/search', label: '搜索' },
  { href: '/about', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="180x180" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.css" />
    <link rel="alternate" type="application/rss+xml" title="豆芽的技术博客" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 豆芽的技术博客`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · 豆芽的技术博客</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="path glitch">豆芽@blog:~$</span> whoami<span class="cursor"></span>
        </a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'active' : ''}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="copy">© {new Date().getFullYear()} 豆芽 · exit code 0
          <span id="busuanzi_container_site_pv" style="display:none"> · pv <span id="busuanzi_value_site_pv"></span></span>
          <span id="busuanzi_container_site_uv" style="display:none"> · uv <span id="busuanzi_value_site_uv"></span></span>
        </div>
        <div class="links">
          <a href="https://github.com/zhaojiale001016" target="_blank" rel="noopener">github</a>
          <span class="dot">·</span>
          <a href="#" id="random-post">随机</a>
          <span class="dot">·</span>
          <a href="/rss.xml">rss</a>
          <span class="dot">·</span>
          <a href="/uses">工具</a>
          <span class="dot">·</span>
          <a href="/friends">友链</a>
          <span class="dot">·</span>
          <a href="/graph">图谱</a>
          <span class="dot">·</span>
          <a href="/now">now</a>
          <span class="dot">·</span>
          <a href="/guestbook">留言板</a>

        </div>
      </div>
    </footer>
    <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <script is:inline define:vars={{ postIds }}>
      window.__POSTS = postIds;
      // 键盘快捷键
      let gPending = false, _escLast = 0;
      const toast = (msg) => {
        let t = document.getElementById('kbd-toast');
        if (!t) {
          t = document.createElement('div');
          t.id = 'kbd-toast';
          t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#242b27;color:#f2efe7;padding:10px 18px;border-radius:8px;font-size:12px;z-index:200;font-family:inherit;white-space:pre;line-height:1.7';
          document.body.appendChild(t);
        }
        t.textContent = msg;
        t.style.display = 'block';
        clearTimeout(t._h);
        t._h = setTimeout(() => (t.style.display = 'none'), 2600);
      };
      const randomPost = () => {
        if (!postIds.length) return;
        const id = postIds[Math.floor(Math.random() * postIds.length)];
        location.href = '/posts/' + id;
      };
      document.getElementById('random-post')?.addEventListener('click', (e) => { e.preventDefault(); randomPost(); });
      document.addEventListener('keydown', (e) => {
        const tag = document.activeElement?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.metaKey || e.ctrlKey || e.altKey) return;
        if (gPending) {
          gPending = false;
          const map = { h: '/', a: '/archives', t: '/tags', s: '/stats' };
          if (map[e.key]) location.href = map[e.key];
          return;
        }
        switch (e.key) {
          case 'g': gPending = true; setTimeout(() => (gPending = false), 800); break;
          case '/': e.preventDefault(); location.href = '/search'; break;
          case 'r': randomPost(); break;
          case 'ArrowLeft': {
            const el = document.querySelector('.post-nav .pn:not(.right)');
            if (el?.href) location.href = el.href;
            break;
          }
          case 'ArrowRight': {
            const el = document.querySelector('.post-nav .pn.right');
            if (el?.href) location.href = el.href;
            break;
          }
          case 'Escape': {
            const now = Date.now();
            if (now - _escLast < 500) {
              toast('快捷键\n  /        搜索\n  r        随机看一篇\n  ← / →    上一篇 / 下一篇（文章页）\n  g h      首页\n  g a      归档\n  g t      标签\n  g s      统计');
              _escLast = 0;
            } else {
              _escLast = now;
            }
            break;
          }
        }
      });
      // 双击页脚 exit code 彩蛋 + 彩带
      document.querySelector('.copy')?.addEventListener('dblclick', () => {
        toast('✨ 你发现了豆芽的秘密通道');
        if (typeof confetti !== 'undefined') {
          confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 }, colors: ['#43a047', '#2b8a9e', '#c7783c', '#66bb6a'] });
        }
      });

      // AOS 初始化（脚本在 body 末尾，DOM 已就绪，直接启动）
      if (typeof AOS !== 'undefined') {
        AOS.init({ duration: 600, easing: 'ease-out', once: true, offset: 50 });
      }

      // NProgress 页面加载
      if (typeof NProgress !== 'undefined') {
        NProgress.configure({ showSpinner: false, trickleSpeed: 200 });
        NProgress.start();
        window.addEventListener('load', () => NProgress.done());
      }

      // Vanta.js 动态背景（浅色小点，不干扰阅读）
      if (typeof VANTA !== 'undefined' && typeof THREE !== 'undefined') {
        VANTA.DOTS({
          el: 'body',
          mouseControls: false,
          touchControls: false,
          gyroControls: false,
          minHeight: 200, minWidth: 200,
          scale: 1, scaleMobile: 1,
          color: 0x43a047,
          color2: 0x2b8a9e,
          backgroundColor: 0xf2efe7,
          size: 2.5,
          spacing: 28,
          showLines: false
        });
      }
    </script>
    <!-- Live2D 看板娘 -->
    <script is:inline src="https://fastly.jsdelivr.net/gh/stevenjoezhang/live2d-widget@latest/autoload.js"></script>

    <!-- AOS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <!-- NProgress -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.js"></script>
    <!-- canvas-confetti -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.js"></script>
    <!-- Vanta.js 动态背景 -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.dots.min.js"></script>
    <!-- Rough Notation -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/rough-notation@0.5.1/lib/rough-notation.iife.js"></script>
    <!-- 鼠标星星尾迹（tholman/cursor-effects） -->
    <script type="module">
      import { fairyDustCursor } from 'https://cdn.jsdelivr.net/npm/cursor-effects@latest/+esm';
      new fairyDustCursor({ colors: ['#43a047', '#2b8a9e', '#66bb6a'] });
    </script>

    <script is:inline>
      // 不蒜子加载完成后显示统计数字
      const t = setInterval(() => {
        if (document.getElementById('busuanzi_value_site_pv')?.innerText) {
          document.getElementById('busuanzi_container_site_pv')?.style.removeProperty('display');
          document.getElementById('busuanzi_container_site_uv')?.style.removeProperty('display');
          clearInterval(t);
        }
      }, 500);
      setTimeout(() => clearInterval(t), 8000);


    </script>
  </body>
</html>
