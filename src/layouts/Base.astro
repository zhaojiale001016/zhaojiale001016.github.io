---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  cover?: string;
}

const { title, description = '豆芽的技术博客：前端、AI、游戏、硬件与技术圈观察', cover } = Astro.props;
const site = 'https://zhaojiale001016.github.io';
const canonical = site + Astro.url.pathname;
const ogImage = cover ? site + cover : undefined;
const path = Astro.url.pathname;
// 全站文章 id 列表（随机漫游用）
import { getCollection } from 'astro:content';
const postIds = (await getCollection('blog')).map((p) => p.id);
// 构建信息：git 短哈希 + 构建时间
import { execSync } from 'node:child_process';
let commit = 'dev';
try {
  commit = execSync('git rev-parse --short HEAD').toString().trim();
} catch {}
const buildTime = new Date().toISOString().slice(0, 16).replace('T', ' ');
const nav = [
  { href: '/', label: 'home' },
  { href: '/archives', label: 'archives' },
  { href: '/tags', label: 'tags' },
  { href: '/stats', label: 'stats' },
  { href: '/subscribe', label: 'subscribe' },
  { href: '/search', label: 'search' },
  { href: '/about', label: 'about' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="180x180" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="豆芽的技术博客" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 豆芽的技术博客`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · 豆芽的技术博客</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="path">douya@blog:~$</span> whoami<span class="cursor"></span>
        </a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'active' : ''}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="copy">© {new Date().getFullYear()} douya · built with Astro · <a class="commit" href={`https://github.com/zhaojiale001016/zhaojiale001016.github.io/commit/${commit}`} target="_blank" rel="noopener">{commit}</a> · {buildTime} · exit code 0
          <span id="busuanzi_container_site_pv" style="display:none"> · pv <span id="busuanzi_value_site_pv"></span></span>
          <span id="busuanzi_container_site_uv" style="display:none"> · uv <span id="busuanzi_value_site_uv"></span></span>
        </div>
        <div class="links">
          <a href="https://github.com/zhaojiale001016" target="_blank" rel="noopener">github</a>
          <a href="#" id="random-post">random</a>
          <a href="/rss.xml">rss</a>
          <a href="/uses">uses</a>
          <a href="/friends">friends</a>
          <a href="/graph">graph</a>
          <a href="/sitemap-index.xml">sitemap</a>
        </div>
      </div>
    </footer>
    <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <script is:inline define:vars={{ postIds }}>
      window.__POSTS = postIds;
      // 键盘快捷键
      let gPending = false;
      const toast = (msg) => {
        let t = document.getElementById('kbd-toast');
        if (!t) {
          t = document.createElement('div');
          t.id = 'kbd-toast';
          t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#242b27;color:#f2efe7;padding:10px 18px;border-radius:8px;font-size:12px;z-index:200;font-family:inherit;white-space:pre;line-height:1.7';
          document.body.appendChild(t);
        }
        t.textContent = msg;
        t.style.display = 'block';
        clearTimeout(t._h);
        t._h = setTimeout(() => (t.style.display = 'none'), 2600);
      };
      const randomPost = () => {
        if (!postIds.length) return;
        const id = postIds[Math.floor(Math.random() * postIds.length)];
        location.href = '/posts/' + id;
      };
      document.getElementById('random-post')?.addEventListener('click', (e) => { e.preventDefault(); randomPost(); });
      document.addEventListener('keydown', (e) => {
        const tag = document.activeElement?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.metaKey || e.ctrlKey || e.altKey) return;
        if (gPending) {
          gPending = false;
          const map = { h: '/', a: '/archives', t: '/tags', s: '/stats' };
          if (map[e.key]) location.href = map[e.key];
          return;
        }
        switch (e.key) {
          case 'g': gPending = true; setTimeout(() => (gPending = false), 800); break;
          case '/': e.preventDefault(); location.href = '/search'; break;
          case 'r': randomPost(); break;
          case 'ArrowLeft': {
            const el = document.querySelector('.post-nav .pn:not(.right)');
            if (el?.href) location.href = el.href;
            break;
          }
          case 'ArrowRight': {
            const el = document.querySelector('.post-nav .pn.right');
            if (el?.href) location.href = el.href;
            break;
          }
          case '?':
            toast('快捷键\n  /        搜索\n  r        随机看一篇\n  ← / →    上一篇 / 下一篇（文章页）\n  g h      首页\n  g a      归档\n  g t      标签\n  g s      统计');
            break;
        }
      });
    </script>
    <script is:inline>
      // Konami 彩蛋
      let k = [];
      const KONAMI = [38,38,40,40,37,39,37,39,66,65];
      document.addEventListener('keydown', (e) => {
        k.push(e.keyCode); k = k.slice(-10);
        if (k.join() === KONAMI.join()) {
          toast('🎮 ↑↑↓↓←→←→BA：欢迎来到豆芽博客的秘密通道。\n这台服务器上跑着 13 篇文章、40 个标签、3.3 万字。\n亏你想得到按这个。');
          k = [];
        }
      });
      // 不蒜子加载完成后显示统计数字
      const t = setInterval(() => {
        if (document.getElementById('busuanzi_value_site_pv')?.innerText) {
          document.getElementById('busuanzi_container_site_pv')?.style.removeProperty('display');
          document.getElementById('busuanzi_container_site_uv')?.style.removeProperty('display');
          clearInterval(t);
        }
      }, 500);
      setTimeout(() => clearInterval(t), 8000);
    </script>
  </body>
</html>
