---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  cover?: string;
  index?: boolean;
}

const { title, description = '豆芽的技术博客：前端、AI、游戏、硬件、篮球与技术圈观察', cover, index = false } = Astro.props;
const site = 'https://zhaojiale001016.github.io';
const canonical = site + Astro.url.pathname;
const ogImage = cover ? site + cover : undefined;
const path = Astro.url.pathname;
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const postHrefs = posts.map((p) => `/posts/${p.id}`);
// 构建信息：git 短哈希 + 构建时间
import { execSync } from 'node:child_process';
let commit = 'dev';
try {
  commit = execSync('git rev-parse --short HEAD').toString().trim();
} catch {}
const sprout = ['   .', '  \\|/', ' --*--', '   |', '  / \\'].join('\n');
const nav = [
  { href: '/', label: '首页' },
  { href: '/archives', label: '归档' },
  { href: '/tags', label: '标签' },
  { href: '/stats', label: '统计' },
  { href: '/subscribe', label: '订阅' },
  { href: '/about', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#157a3e" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="180x180" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="豆芽的技术博客" href="/rss.xml" />
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
    <script is:inline src="/pagefind/pagefind-highlight.js"></script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · 豆芽的技术博客`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · 豆芽的技术博客</title>
  </head>
  <body>
    <a class="skip" href="#content">跳到正文</a>
    <canvas id="site-bg" class="site-bg" aria-hidden="true"></canvas>
    <script is:inline>
      (() => {
        const canvas = document.getElementById('site-bg');
        const ctx = canvas?.getContext('2d', { alpha: false });
        if (!ctx) return;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        let w = 0, h = 0;
        const glyphs = ['.', '$', '>', '_', '#', '/', '~'];
        const fit = () => {
          w = innerWidth;
          h = innerHeight;
          canvas.width = Math.floor(w * dpr);
          canvas.height = Math.floor(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        const paint = (sec) => {
          ctx.globalAlpha = 1;
          ctx.fillStyle = '#f2efe6';
          ctx.fillRect(0, 0, w, h);
          ctx.font = '13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
          ctx.fillStyle = 'rgba(21,122,62,0.16)';
          const col = 16;
          const row = 22;
          const cols = Math.ceil(w / col);
          const rows = Math.ceil(h / row);
          const shift = reduce ? 0 : Math.floor(sec * 1.5);
          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              if ((r * 3 + c) % 6 !== 0) continue;
              ctx.fillText(glyphs[(r + c + shift) % glyphs.length], c * col, r * row + 14);
            }
          }
          if (!reduce && Math.floor(sec * 2) % 2 === 0) {
            ctx.fillStyle = 'rgba(21,122,62,0.38)';
            ctx.fillRect((Math.floor(sec * 4) % cols) * col, (rows - 2) * row, 9, 14);
          }
        };
        const frame = (now) => {
          paint((now || 0) / 1000);
          if (!reduce && document.visibilityState !== 'hidden') requestAnimationFrame(frame);
        };
        fit();
        addEventListener('resize', () => { fit(); if (reduce) paint(0); });
        document.addEventListener('visibilitychange', () => { if (!reduce && document.visibilityState === 'visible') requestAnimationFrame(frame); });
        requestAnimationFrame(frame);
      })();
    </script>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="path">豆芽@blog:~$</span> whoami<span class="cursor"></span>
        </a>
        <div class="header-tools">
          <pagefind-modal-trigger placeholder="find" shortcut="/"></pagefind-modal-trigger>
          <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'active' : ''}>{n.label}</a>
          ))}
          </nav>
        </div>
      </div>
    </header>

    <main id="content" data-pagefind-body={index || undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="copy">© {new Date().getFullYear()} 豆芽 · exit 0 · build {commit}
          <span id="busuanzi_container_site_pv" style="display:none"> · pv <span id="busuanzi_value_site_pv"></span></span>
          <span id="busuanzi_container_site_uv" style="display:none"> · uv <span id="busuanzi_value_site_uv"></span></span>
        </div>
        <div class="links">
          <a href="https://github.com/zhaojiale001016" target="_blank" rel="noopener">github</a>
          <span class="dot">·</span>
          <a href="#" id="random-post">随机</a>
          <span class="dot">·</span>
          <a href="/rss.xml">rss</a>
          <span class="dot">·</span>
          <a href="/uses">工具</a>
          <span class="dot">·</span>
          <a href="/friends">友链</a>
          <span class="dot">·</span>
          <a href="/now">now</a>
          <span class="dot">·</span>
          <a href="/guestbook">留言板</a>

        </div>
      </div>
    </footer>
    <aside class="buddy" id="buddy">
      <div class="buddy-bar">
        <i></i><i></i><i></i>
        <span>sprout@blog</span>
        <button type="button" id="buddy-fold" aria-label="收起豆芽">_</button>
      </div>
      <div class="buddy-body">
        <pre class="buddy-art" aria-hidden="true">{sprout}</pre>
        <p class="buddy-line"><span class="prompt">➜</span> status: active<span class="buddy-caret"></span></p>
      </div>
    </aside>
    <pagefind-config bundle-path="/pagefind/" lang="zh-cn" highlight-param="highlight"></pagefind-config>
    <pagefind-modal></pagefind-modal>
    <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <script>
      import { listen } from 'quicklink';
      listen({
        limit: 8,
        delay: 200,
        ignores: [/\/rss/, (uri) => uri.includes('#')],
      });
    </script>
    <script is:inline define:vars={{ postHrefs }}>
      const randomPost = () => {
        if (!postHrefs.length) return;
        location.href = postHrefs[Math.floor(Math.random() * postHrefs.length)];
      };
      document.getElementById('random-post')?.addEventListener('click', (e) => { e.preventDefault(); randomPost(); });
      document.addEventListener('keydown', (e) => {
        const tag = document.activeElement?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === 'r') randomPost();
        else if (e.key === 'ArrowLeft') document.querySelector('.post-nav .pn:not(.right)')?.click();
        else if (e.key === 'ArrowRight') document.querySelector('.post-nav .pn.right')?.click();
      });

      const buddy = document.getElementById('buddy');
      const foldBuddy = (folded, persist) => {
        buddy?.classList.toggle('folded', folded);
        const btn = document.getElementById('buddy-fold');
        if (btn) btn.textContent = folded ? '+' : '_';
        if (persist) {
          try { localStorage.setItem('buddy-folded', folded ? '1' : '0'); } catch {}
        }
      };
      let savedFold = null;
      try { savedFold = localStorage.getItem('buddy-folded'); } catch {}
      const roomy = matchMedia('(min-width: 1440px)').matches;
      foldBuddy(savedFold === null ? !roomy : savedFold === '1', false);
      document.getElementById('buddy-fold')?.addEventListener('click', () => {
        if (!buddy) return;
        foldBuddy(!buddy.classList.contains('folded'), true);
      });
    </script>

    <script is:inline>
      // 不蒜子加载完成后显示统计数字
      const t = setInterval(() => {
        if (document.getElementById('busuanzi_value_site_pv')?.innerText) {
          document.getElementById('busuanzi_container_site_pv')?.style.removeProperty('display');
          document.getElementById('busuanzi_container_site_uv')?.style.removeProperty('display');
          clearInterval(t);
        }
      }, 500);
      setTimeout(() => clearInterval(t), 8000);


    </script>
  </body>
</html>
