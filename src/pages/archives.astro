---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const categories = [...new Set(posts.map((p) => p.data.category))];

// 写作热力图：最近 26 周（半年），按周×星期排布
const countByDay = new Map<string, number>();
for (const p of posts) {
  const k = fmt(p.data.pubDate);
  countByDay.set(k, (countByDay.get(k) ?? 0) + 1);
}
const today = new Date();
today.setHours(0, 0, 0, 0);
const WEEKS = 26;
const start = new Date(today);
start.setDate(start.getDate() - start.getDay() - (WEEKS - 1) * 7); // 从周日对齐
const cells: { date: string; count: number; future: boolean }[] = [];
for (let i = 0; i < WEEKS * 7; i++) {
  const d = new Date(start);
  d.setDate(d.getDate() + i);
  const k = fmt(d);
  cells.push({ date: k, count: countByDay.get(k) ?? 0, future: d > today });
}
const level = (c: number) => (c === 0 ? 0 : c === 1 ? 1 : c === 2 ? 2 : 3);
const totalDays = new Set([...countByDay.keys()]).size;
---

<Base title="archives">
  <div class="wrap" style="padding-top: 44px; padding-bottom: 48px; max-width: 860px;">
    <div class="term">
      <div class="term-bar">
        <i></i><i></i><i></i>
        <span class="title">douya@blog: ~/posts — zsh</span>
      </div>
      <div class="term-body">
        <span class="line"><span class="prompt">➜ ~/posts</span> <span class="cmd">ls -la --sort=time</span></span>
        <span class="out">total {posts.length} · categories: {categories.join(', ')}</span>

        <div class="heat-wrap">
          <div class="heat-title">$ git log --stat（近半年写作热力 · 活跃 {totalDays} 天）</div>
          <div class="heat" role="img" aria-label="写作热力图">
            {cells.map((c) => (
              <i
                class={`lv${level(c.count)}${c.future ? ' future' : ''}`}
                title={`${c.date} · ${c.count} 篇`}
              />
            ))}
          </div>
          <div class="heat-legend">
            <span>少</span><i class="lv0" /><i class="lv1" /><i class="lv2" /><i class="lv3" /><span>多</span>
          </div>
        </div>

        {years.map((y) => (
          <div class="arch-group">
            <div class="arch-year">{y}/</div>
            {byYear.get(y)!.map((p) => (
              <div class="list-item">
                <time>{fmt(p.data.pubDate)}</time>
                <a href={`/posts/${p.id}`}>{p.data.title}</a>
                <span class="cat">{p.data.category}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .heat-wrap { margin: 18px 0 8px; padding: 16px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); }
  .heat-title { font-size: .78rem; color: var(--green); font-weight: 700; margin-bottom: 12px; }
  .heat {
    display: grid; grid-template-rows: repeat(7, 1fr); grid-auto-flow: column;
    grid-auto-columns: 1fr; gap: 3px; width: 100%;
  }
  .heat i { aspect-ratio: 1; border-radius: 3px; background: #e8e4d8; }
  .heat i.lv1 { background: #9fd4a8; }
  .heat i.lv2 { background: #4caf7d; }
  .heat i.lv3 { background: #1f7a4d; }
  .heat i.future { background: transparent; }
  .heat-legend { display: flex; align-items: center; gap: 4px; justify-content: flex-end; margin-top: 10px; font-size: .68rem; color: var(--ink-3); }
  .heat-legend i { width: 10px; height: 10px; border-radius: 2px; background: #e8e4d8; }
  .heat-legend i.lv1 { background: #9fd4a8; }
  .heat-legend i.lv2 { background: #4caf7d; }
  .heat-legend i.lv3 { background: #1f7a4d; }
</style>
