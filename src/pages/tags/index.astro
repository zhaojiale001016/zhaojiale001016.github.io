---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog');
const count = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) count.set(t, (count.get(t) ?? 0) + 1);
const tags = [...count.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="标签">
  <div class="wrap" style="padding-top: 44px; padding-bottom: 48px; max-width: 860px;">
    <div class="term">
      <div class="term-bar"><i></i><i></i><i></i><span class="title">豆芽@blog: ~/tags — zsh</span></div>
      <div class="term-body">
        <span class="line"><span class="prompt">➜ ~/tags</span> <span class="cmd">ls -l | sort -k5 -rn</span></span>
        <span class="out">total {tags.length} 个标签，点任意标签筛选文章</span>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px;">
          {tags.map(([t, n]) => (
            <a href={`/tags/${encodeURIComponent(t)}`} class="tag-chip">
              #{t} <b>{n}</b>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .tag-chip {
    display: inline-flex; gap: 6px; align-items: center;
    padding: 6px 14px; border: 1px solid var(--line-strong); border-radius: 6px;
    background: var(--panel); color: var(--cyan); font-size: .85rem;
    transition: all .15s;
  }
  .tag-chip b { color: var(--green); font-size: .78rem; }
  .tag-chip:hover { border-color: var(--green); transform: translateY(-2px); box-shadow: var(--shadow); }
</style>
