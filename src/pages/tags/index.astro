---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog');
const count = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) count.set(t, (count.get(t) ?? 0) + 1);
const tags = [...count.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="标签">
  <div class="wrap" style="padding-top: 44px; padding-bottom: 48px; max-width: 860px;">
    <div class="term">
      <div class="term-bar"><i></i><i></i><i></i><span class="title">豆芽@blog: ~/tags — zsh</span></div>
      <div class="term-body">
        <span class="line"><span class="prompt">➜ ~/tags</span> <span class="cmd">ls -l | sort -k5 -rn</span></span>
        <span class="out">total {tags.length} 个标签，点任意标签筛选文章</span>
        <div class="tag-cloud">
          {tags.map(([t, n]) => {
            const max = tags[0]?.[1] ?? 1;
            const scale = 0.7 + (n / max) * 0.6;
            return (
              <a href={`/tags/${encodeURIComponent(t)}`} class="tag-cloud-item" style={`font-size: ${scale}rem; opacity: ${0.6 + (n / max) * 0.4}`}>
                #{t} <b>{n}</b>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; align-items: baseline; }
  .tag-cloud-item {
    display: inline-flex; gap: 4px; align-items: baseline;
    padding: 4px 10px; border-radius: 6px;
    color: var(--cyan); transition: all .15s;
    line-height: 1.4;
  }
  .tag-cloud-item b { color: var(--green); font-size: .7em; }
  .tag-cloud-item:hover { color: var(--green); background: rgba(67,160,71,.08); }
</style>
