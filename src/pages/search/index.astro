---
import Base from '../../layouts/Base.astro';
---

<Base title="search">
  <div class="wrap" style="padding-top: 44px; padding-bottom: 48px; max-width: 860px;">
    <div class="term">
      <div class="term-bar"><i></i><i></i><i></i><span class="title">douya@blog: ~/search — zsh</span></div>
      <div class="term-body">
        <span class="line"><span class="prompt">➜ ~/search</span> <span class="cmd">grep -ri "<span id="echo" style="color: var(--amber);"></span>" ../posts/</span></span>
        <input
          id="q"
          type="text"
          placeholder="输入关键词，搜索标题 / 摘要 / 正文 / 标签…"
          autofocus
          style="width: 100%; margin-top: 16px; padding: 12px 16px; font-family: var(--mono); font-size: .95rem; background: var(--panel); color: var(--ink); border: 1px solid var(--line-strong); border-radius: 6px; outline: none;"
        />
        <div id="hint" style="margin-top: 14px; font-size: .82rem; color: var(--ink-3);">支持中文，实时匹配</div>
        <div id="results" style="margin-top: 8px;"></div>
      </div>
    </div>
  </div>

  <script>
    const q = document.getElementById('q');
    const results = document.getElementById('results');
    const hint = document.getElementById('hint');
    const echo = document.getElementById('echo');
    let posts = [];
    fetch('/search/index.json')
      .then((r) => r.json())
      .then((d) => { posts = d; q.focus(); });

    function esc(s) {
      return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    }
    function render(list, kw) {
      if (!kw) { results.innerHTML = ''; hint.textContent = '支持中文，实时匹配'; return; }
      hint.textContent = `找到 ${list.length} 篇`;
      results.innerHTML = list.map((p) => `
        <div class="list-item">
          <time>${p.date}</time>
          <a href="/posts/${p.id}">${esc(p.title)}</a>
          <span class="cat">${esc(p.category)}</span>
        </div>
      `).join('') || '<div style="padding: 20px 0; color: var(--ink-3); font-size: .85rem;">grep: no matches found</div>';
    }
    q.addEventListener('input', () => {
      const kw = q.value.trim().toLowerCase();
      echo.textContent = q.value;
      if (!kw) return render([], '');
      const hit = posts.filter((p) =>
        [p.title, p.description, p.category, p.body, ...(p.tags || [])]
          .join(' ').toLowerCase().includes(kw)
      );
      render(hit, kw);
    });
  </script>
</Base>
