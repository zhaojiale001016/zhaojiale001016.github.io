---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { category, posts } = Astro.props;
const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title={category}>
  <div class="wrap" style="padding-top: 44px; padding-bottom: 48px; max-width: 860px;">
    <div class="term">
      <div class="term-bar"><i></i><i></i><i></i><span class="title">douya@blog: ~/categories — zsh</span></div>
      <div class="term-body">
        <span class="line"><span class="prompt">➜ ~/categories</span> <span class="cmd">ls {category}/</span></span>
        <span class="out">{posts.length} 篇文章 · <a href="/archives" style="color: var(--cyan);">cd ../archives</a></span>
        {posts.map((p) => (
          <div class="list-item">
            <time>{fmt(p.data.pubDate)}</time>
            <a href={`/posts/${p.id}`}>{p.data.title}</a>
            <span class="cat">{p.data.category}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</Base>
