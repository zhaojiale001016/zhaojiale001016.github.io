---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
  return posts.map((post, i) => {
    // 相关阅读：同分类优先，其次共享标签数
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        p,
        score:
          (p.data.category === post.data.category ? 10 : 0) +
          p.data.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 3)
      .map((r) => r.p);
    return {
      params: { slug: post.id },
      props: {
        post,
        prev: posts[i + 1] ?? null,
        next: posts[i - 1] ?? null,
        related,
      },
    };
  });
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const minutes = Math.max(1, Math.round((post.body?.length ?? 0) / 400));
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.cover ? `https://zhaojiale001016.github.io${post.data.cover}` : undefined,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: '豆芽', url: 'https://zhaojiale001016.github.io/about' },
  publisher: { '@type': 'Organization', name: '豆芽的技术博客', logo: { '@type': 'ImageObject', url: 'https://zhaojiale001016.github.io/icon-192.png' } },
};
---

<Base title={post.data.title} description={post.data.description} cover={post.data.cover}>
  <div class="article-layout">
    <script type="application/ld+json" set:html={JSON.stringify(ldJson)}></script>
    <article class="article">
      <div class="article-head">
        <span class="path">➜ ~/posts $ cat ./{post.id}.md</span>
        <h1>{post.data.title}</h1>
        <div class="meta" style="margin-top: 16px; margin-bottom: 0;">
          <a class="cat" href={`/categories/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
          <time>{fmt(post.data.pubDate)}</time>
          <span>约 {minutes} 分钟读完</span>
          <span id="busuanzi_container_page_pv">· 阅读 <span id="busuanzi_value_page_pv">-</span> 次</span>
        </div>
      </div>
      {post.data.cover && <img class="cover" src={post.data.cover} alt={post.data.title} />}
      <div class="prose">
        <Content />
      </div>
      {post.data.tags.length > 0 && (
        <div class="article-tags">
          {post.data.tags.map((t) => (
            <a href={`/tags/${encodeURIComponent(t)}`}>{t}</a>
          ))}
        </div>
      )}

      <div class="edit-link">
        <a href={`https://github.com/zhaojiale001016/zhaojiale001016.github.io/edit/source/src/content/blog/${post.id}.md`} target="_blank" rel="noopener">$ git edit ./posts/{post.id}.md → 在 GitHub 上编辑此页</a>
      </div>

      <nav class="post-nav">
        {prev ? (
          <a class="pn" href={`/posts/${prev.id}`}>
            <span class="dir">← 上一篇</span>
            <span class="t">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pn right" href={`/posts/${next.id}`}>
            <span class="dir">下一篇 →</span>
            <span class="t">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>

      {related.length > 0 && (
        <section class="related">
          <div class="section-head" style="margin: 0 0 16px;">
            <h2>相关阅读</h2>
          </div>
          <div class="related-grid">
            {related.map((r) => (
              <a class="rel" href={`/posts/${r.id}`}>
                <span class="cat">{r.data.category}</span>
                <span class="t">{r.data.title}</span>
                <time>{fmt(r.data.pubDate)}</time>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="评论">
        <div class="section-head" style="margin: 0 0 18px;">
          <h2>评论</h2>
        </div>
        <script
          src="https://giscus.app/client.js"
          data-repo="zhaojiale001016/zhaojiale001016.github.io"
          data-repo-id="R_kgDOVjsqow"
          data-category="General"
          data-category-id="DIC_kwDOVjsqo84DKcIg"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="light"
          data-lang="zh-CN"
          crossorigin="anonymous"
          async
        ></script>
      </section>
    </article>

    {toc.length > 0 && (
      <aside class="toc">
        <div class="toc-title">$ 目录</div>
        <nav id="toc-nav">
          {toc.map((h) => (
            <a href={`#${h.slug}`} class={h.depth === 3 ? 'lv3' : ''} data-slug={h.slug}>{h.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>

  <div class="progress" id="progress"></div>
  <button class="to-top" id="to-top" title="回到顶部">↑ top</button>
</Base>

<style>
  .article-layout {
    max-width: 1080px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr) 220px;
    gap: 32px; padding: 0 24px;
  }
  .article { padding: 48px 0 80px; max-width: 800px; }
  .toc {
    position: sticky; top: 88px; align-self: start;
    margin-top: 48px; padding: 18px;
    background: var(--paper); border: 1px solid var(--line);
    border-radius: var(--radius); font-size: .8rem;
    max-height: calc(100vh - 120px); overflow-y: auto;
  }
  .toc-title { color: var(--green); font-weight: 700; margin-bottom: 10px; font-size: .78rem; }
  .toc nav a {
    display: block; padding: 4px 0 4px 12px; color: var(--ink-2);
    border-left: 2px solid var(--line); line-height: 1.5;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .toc nav a.lv3 { padding-left: 26px; font-size: .76rem; }
  .toc nav a:hover { color: var(--green); }
  .toc nav a.active { color: var(--green); border-left-color: var(--green); font-weight: 700; }
  .评论 {
    margin-top: 48px; background: var(--paper);
    border: 1px solid var(--line); border-radius: var(--radius); padding: 24px;
  }
  .edit-link { margin-top: 32px; text-align: center; }
  .edit-link a { font-size: .75rem; color: var(--ink-3); }
  .edit-link a:hover { color: var(--green); }
  .related { margin-top: 48px; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .rel {
    display: flex; flex-direction: column; gap: 8px;
    background: var(--paper); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 14px 16px;
    transition: border-color .15s, transform .15s;
  }
  .rel:hover { border-color: var(--green); transform: translateY(-2px); }
  .rel .cat { font-size: .68rem; color: var(--green); font-weight: 700; }
  .rel .t {
    font-size: .82rem; color: var(--ink); font-weight: 700; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rel time { font-size: .7rem; color: var(--ink-3); }
  .progress {
    position: fixed; top: 0; left: 0; height: 3px; width: 0;
    background: var(--green); z-index: 100;
    transition: width .1s linear;
  }
  .to-top {
    position: fixed; right: 22px; bottom: 22px;
    background: var(--paper); color: var(--green);
    border: 1px solid var(--green); border-radius: var(--radius);
    font-family: inherit; font-size: .75rem; font-weight: 700;
    padding: 8px 14px; cursor: pointer; z-index: 90;
    opacity: 0; pointer-events: none; transform: translateY(8px);
    transition: opacity .2s, transform .2s;
  }
  .to-top.show { opacity: 1; pointer-events: auto; transform: none; }
  .to-top:hover { background: var(--green); color: #fff; }
  @media (max-width: 720px) {
    .related-grid { grid-template-columns: 1fr; }
  }
  .post-nav {
    display: flex; justify-content: space-between; gap: 16px; margin-top: 40px;
  }
  .pn {
    flex: 1; max-width: 48%;
    display: flex; flex-direction: column; gap: 6px;
    background: var(--paper); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 14px 18px;
    transition: border-color .15s, transform .15s;
  }
  .pn:hover { border-color: var(--green); transform: translateY(-2px); }
  .pn.right { text-align: right; margin-left: auto; }
  .pn .dir { font-size: .72rem; color: var(--green); font-weight: 700; }
  .pn .t { font-size: .85rem; color: var(--ink-2); line-height: 1.5; }
  .article-tags a { color: var(--cyan); }
  .article-tags a::before { content: "#"; }
  .article-tags a:hover { color: var(--green); }
  .meta a.cat:hover { text-decoration: underline; }
  @media (max-width: 960px) {
    .article-layout { grid-template-columns: 1fr; }
    .toc { display: none; }
  }
</style>

<script>
  const links = document.querySelectorAll('#toc-nav a');
  if (links.length) {
    const map = new Map();
    links.forEach((l) => {
      const el = document.getElementById(l.dataset.slug);
      if (el) map.set(el, l);
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove('active'));
          map.get(e.target)?.classList.add('active');
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });
    map.forEach((_, el) => io.observe(el));
  }

  // 阅读进度条
  const bar = document.getElementById('progress');
  const toTop = document.getElementById('to-top');
  const onScroll = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (bar) bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
    toTop?.classList.toggle('show', h.scrollTop > 600);
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  // 图片灯箱（medium-zoom）
  import('https://cdn.jsdelivr.net/npm/medium-zoom@1.1.0/+esm').then(({ default: mediumZoom }) => {
    mediumZoom('.prose img, article.article img.cover', {
      background: 'rgba(36, 43, 39, .85)',
      margin: 24,
    });
  }).catch(() => {});
</script>
