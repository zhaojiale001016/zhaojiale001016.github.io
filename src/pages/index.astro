---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const PAGE_SIZE = 8;

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const [featured, ...rest] = posts;
const pagePosts = rest.slice(0, PAGE_SIZE);
const popular = [...posts].sort((a, b) => b.data.tags.length - a.data.tags.length).slice(0, 5);
const totalPages = Math.max(1, Math.ceil((rest.length - PAGE_SIZE) / PAGE_SIZE));
const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const categories = [...new Set(posts.map((p) => p.data.category))];
---

<Base title="首页">
  <section class="hero">
    <div class="wrap">
      <div class="term">
        <div class="term-bar">
          <i></i><i></i><i></i>
          <span class="title">豆芽@blog: ~ — zsh — 80×24</span>
        </div>
        <div class="term-body">
          <span class="line"><span class="prompt">➜ ~</span> <span class="cmd">./whoami</span></span>
          <span class="out" id="typed-out"><span id="typed-text"></span><span class="typed-cursor">▊</span></span>
          <h1>豆芽的技术博客</h1>
          <span class="line"><span class="prompt">➜ ~</span> <span class="cmd">stat ./posts --format=summary</span></span>
          <div class="stats">
            <span class="stat">posts: <b>{posts.length}</b></span>
            <span class="stat">categories: <b>{categories.join(' / ')}</b></span>
            <span class="stat">updated: <b>{posts[0] ? fmt(posts[0].data.pubDate) : '-'}</b></span>
            <span class="stat">status: <b>active</b></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="section-head">
      <h2>最新文章</h2>
      <a class="more" href="/archives">cat archives →</a>
    </div>

    {featured && (
      <a class="featured" href={`/posts/${featured.id}`} data-aos="fade-up">
        {featured.data.cover && <img class="cover" src={featured.data.cover} alt={featured.data.title} />}
        <div class="body">
          <div class="meta">
            <span class="cat">{featured.data.category}</span>
            <time>{fmt(featured.data.pubDate)}</time>
            <span class="read-time">{Math.max(1, Math.round((featured.body?.length ?? 0) / 400))} 分钟</span>
          </div>
          <h3>{featured.data.title}</h3>
          <p class="desc">{featured.data.description}</p>
          <span class="read-more">阅读全文{featured.id}</span>
        </div>
      </a>
    )}

    {popular.length > 0 && (
      <div class="popular-section">
        <div class="section-head" style="margin: 0 0 14px;">
          <h2>热门文章</h2>
        </div>
        <div class="popular-list">
          {popular.map((p, i) => (
            <a class="pop-item" href={`/posts/${p.id}`} data-aos="fade-right">
              <span class="pop-rank">{i + 1}</span>
              <span class="pop-title">{p.data.title}</span>
              <span class="pop-cat">{p.data.category}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <script is:inline src="https://cdn.jsdelivr.net/npm/typed.js@2.1.0/dist/typed.umd.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof Typed === 'undefined') return;
      new Typed('#typed-text', {
        strings: [
          '你好，我是豆芽。写代码，也写代码背后的世界——<strong style="color:var(--green)">前端 × AI × 游戏 × 硬件 × 篮球</strong>，技术圈的每一场变局都逃不过这个终端。'
        ],
        typeSpeed: 40,
        backSpeed: 0,
        loop: false,
        showCursor: true,
        cursorChar: '▊',
        contentType: 'html',
        onComplete: (self) => {
          setTimeout(() => self.cursor?.classList.add('typed-cursor'), 500);
        }
      });
    });
  </script>

  <div class="grid" style="margin-top: 20px;">
      {pagePosts.map((p) => (
        <article class="card" data-aos="fade-up" data-aos-delay={Math.min(100 * pagePosts.indexOf(p), 400)}>
          {p.data.cover && (
            <a href={`/posts/${p.id}`}><img class="cover" src={p.data.cover} alt={p.data.title} loading="lazy" /></a>
          )}
          <div class="body">
            <div class="meta">
              <span class="cat">{p.data.category}</span>
              <time>{fmt(p.data.pubDate)}</time>
              <span class="read-time">{Math.max(1, Math.round((p.body?.length ?? 0) / 400))} 分钟</span>
            </div>
            <h3><a href={`/posts/${p.id}`}>{p.data.title}</a></h3>
            <p class="desc">{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <div class="标签">{p.data.tags.slice(0, 3).map((t) => <a href={`/tags/${encodeURIComponent(t)}`}><span>{t}</span></a>)}</div>
            )}
          </div>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="pager">
        <span class="cur">page 1 / {totalPages}</span>
        <a href="/page/1">较旧 →</a>
      </nav>
    )}
  </div>
</Base>
